# =============================================================================
# Stage 1: Build
# =============================================================================
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src

# Copy go mod/sum first for better layer caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build args for cross-compilation (multi-arch support)
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILDTIME=unknown

# Build otoxan-mcp-knowledge binary with version ldflags
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath \
    -ldflags "\
      -X github.com/silas/otoxan/internal/version.Version=${VERSION} \
      -X github.com/silas/otoxan/internal/version.Commit=${COMMIT} \
      -X github.com/silas/otoxan/internal/version.BuildTime=${BUILDTIME}" \
    -o /otoxan-mcp-knowledge \
    ./cmd/otoxan-mcp-knowledge/

# =============================================================================
# Stage 2: Runtime
# =============================================================================
FROM docker.io/library/alpine:3.21 AS runtime

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user for security
RUN addgroup -g 1000 mcp-knowledge && \
    adduser -u 1000 -G mcp-knowledge -s /bin/sh -D mcp-knowledge

WORKDIR /app

# Copy binary from builder
COPY --from=builder /otoxan-mcp-knowledge /app/otoxan-mcp-knowledge

# Copy health check wrapper script
COPY --from=builder /src/deploy/docker/healthcheck-mcp.sh /usr/local/bin/healthcheck

# Copy config dir skeleton (can be volume-mounted at runtime)
RUN mkdir -p /etc/otoxan /home/mcp-knowledge/.otoxan/run && \
    chown -R mcp-knowledge:mcp-knowledge /app /home/mcp-knowledge/.otoxan

USER mcp-knowledge:mcp-knowledge

# Expose the standard otoxan home path
ENV OTOXAN_HOME=/home/mcp-knowledge/.otoxan

# Health check: run a quick initialization test against Mongo
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /usr/local/bin/healthcheck /app/otoxan-mcp-knowledge || exit 1

ENTRYPOINT ["/app/otoxan-mcp-knowledge"]
