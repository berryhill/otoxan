# =============================================================================
# Stage 1: Build
# =============================================================================
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src

# Copy go mod/sum first for better layer caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build args for cross-compilation (multi-arch support)
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILDTIME=unknown

# Build xander binary with version ldflags
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath \
    -ldflags "\
      -X github.com/silas/otoxan/internal/version.Version=${VERSION} \
      -X github.com/silas/otoxan/internal/version.Commit=${COMMIT} \
      -X github.com/silas/otoxan/internal/version.BuildTime=${BUILDTIME}" \
    -tags xander \
    -o /xander \
    ./cmd/xander/

# =============================================================================
# Stage 2: Runtime
# =============================================================================
FROM docker.io/library/alpine:3.21 AS runtime

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user for security
RUN addgroup -g 1000 xander && \
    adduser -u 1000 -G xander -s /bin/sh -D xander

WORKDIR /app

# Copy binary from builder
COPY --from=builder /xander /app/xander

# Copy config dir skeleton (can be volume-mounted at runtime)
RUN mkdir -p /etc/otoxan /home/xander/.otoxan/run && \
    chown -R xander:xander /app /home/xander/.otoxan

USER xander:xander

# Expose the standard xander socket path
ENV XANDER_SOCKET_DIR=/home/xander/.otoxan/run

ENTRYPOINT ["/app/xander"]
